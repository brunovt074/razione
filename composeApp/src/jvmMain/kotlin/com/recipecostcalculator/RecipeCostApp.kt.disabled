@Composable
fun RecipeCostApp(databasePath: String = "recipe-cost.db") {
    val database = remember(databasePath) { SQLiteDatabase(databasePath) }
    val ingredientRepository: IngredientRepository = remember { database.ingredientRepository() }
    val recipeRepository: RecipeRepository = remember { database.recipeRepository() }
    val fixedCostRepository = remember { database.fixedCostRepository() }
    val pricingRepository = remember { database.pricingRepository() }

    val costCalculatorService = remember {
        CostCalculatorService(
            ingredientRepository = ingredientRepository,
            recipeRepository = recipeRepository,
        )
    }

    val createIngredientUseCase = remember { CreateIngredientUseCase(ingredientRepository) }
    val updateIngredientCostUseCase = remember { UpdateIngredientCostUseCase(ingredientRepository) }
    val getAllIngredientsUseCase = remember { GetAllIngredientsUseCase(ingredientRepository) }
    val createRecipeUseCase = remember { CreateRecipeUseCase(recipeRepository) }
    val addComponentToRecipeUseCase = remember { AddComponentToRecipeUseCase(recipeRepository) }
    val getAllRecipesUseCase = remember { GetAllRecipesUseCase(recipeRepository) }
    val calculateRecipeCostUseCase = remember {
        CalculateRecipeCostUseCase(
            recipeRepository = recipeRepository,
            costCalculatorService = costCalculatorService,
        )
    }

    val addFixedCostItemUseCase = remember { AddFixedCostItemUseCase(fixedCostRepository) }
    val getFixedCostItemsUseCase = remember { GetFixedCostItemsUseCase(fixedCostRepository) }
    val setProductionPerMonthUseCase = remember { SetProductionPerMonthUseCase(fixedCostRepository) }
    val getProductionConfigurationUseCase = remember { GetProductionConfigurationUseCase(fixedCostRepository) }
    val calculateFixedCostSummaryUseCase = remember { CalculateFixedCostSummaryUseCase(fixedCostRepository) }

    val savePricingConfigurationUseCase = remember { SavePricingConfigurationUseCase(pricingRepository) }
    val getPricingConfigurationUseCase = remember { GetPricingConfigurationUseCase(pricingRepository) }
    val addPriceListProductUseCase = remember { AddPriceListProductUseCase(pricingRepository) }
    val getPriceListProductsUseCase = remember { GetPriceListProductsUseCase(pricingRepository) }
    val setPriceListCostBasisUseCase = remember { SetPriceListCostBasisUseCase(pricingRepository) }
    val getPriceListCostBasisUseCase = remember { GetPriceListCostBasisUseCase(pricingRepository) }
    val calculatePricingSummaryUseCase = remember {
        CalculatePricingSummaryUseCase(
            calculateRecipeCostUseCase = calculateRecipeCostUseCase,
            calculateFixedCostSummaryUseCase = calculateFixedCostSummaryUseCase,
            pricingRepository = pricingRepository,
        )
    }
    val buildPriceListRowsUseCase = remember { BuildPriceListRowsUseCase(pricingRepository) }

    val createIngredient = remember {
        { command: CreateIngredientCommand ->
            createIngredientUseCase.execute(command)
            Unit
        }
    }
    val updateIngredientCost = remember {
        { command: UpdateIngredientCostCommand ->
            updateIngredientCostUseCase.execute(command)
            Unit
        }
    }
    val createRecipe = remember {
        { command: CreateRecipeCommand ->
            createRecipeUseCase.execute(command)
            Unit
        }
    }
    val addComponentToRecipe = remember {
        { command: AddComponentToRecipeCommand ->
            addComponentToRecipeUseCase.execute(command)
            Unit
        }
    }
    val calculateRecipeCost = remember {
        { query: CalculateRecipeCostQuery ->
            calculateRecipeCostUseCase.execute(query)
        }
    }

    val addFixedCostItem = remember {
        { name: String, amount: BigDecimal ->
            addFixedCostItemUseCase.execute(
                AddFixedCostItemCommand(
                    name = name,
                    monthlyAmount = Money.of(amount),
                ),
            )
            Unit
        }
    }
    val updateProductionPerMonth = remember {
        { value: BigDecimal ->
            setProductionPerMonthUseCase.execute(SetProductionPerMonthCommand(pizzasPerMonth = value))
            Unit
        }
    }
    val savePricingConfiguration = remember {
        { sellingPrice: BigDecimal, commissionPercent: BigDecimal, wastePercent: BigDecimal, targetMarginPercent: BigDecimal ->
            savePricingConfigurationUseCase.execute(
                SavePricingConfigurationCommand(
                    sellingPricePerPizza = Money.of(sellingPrice),
                    commissionPercent = commissionPercent,
                    wastePercent = wastePercent,
                    targetMarginPercent = targetMarginPercent,
                ),
            )
            Unit
        }
    }
    val addPriceListProduct = remember {
        { name: String, sellingPrice: BigDecimal, notes: String ->
            addPriceListProductUseCase.execute(
                AddPriceListProductCommand(
                    name = name,
                    sellingPrice = Money.of(sellingPrice),
                    notes = notes,
                ),
            )
            Unit
        }
    }

    val ingredientPresenter = remember {
        IngredientPresenter(
            getAllIngredients = getAllIngredientsUseCase,
            createIngredient = createIngredient,
            updateIngredientCost = updateIngredientCost,
        )
    }

    val recipePresenter = remember {
        RecipePresenter(
            getAllIngredients = getAllIngredientsUseCase,
            getAllRecipes = getAllRecipesUseCase,
            createRecipe = createRecipe,
            addComponentToRecipe = addComponentToRecipe,
        )
    }

    val fixedCostPresenter = remember {
        FixedCostPresenter(
            getFixedCostItemsUseCase = getFixedCostItemsUseCase,
            getProductionConfigurationUseCase = getProductionConfigurationUseCase,
            calculateFixedCostSummaryUseCase = calculateFixedCostSummaryUseCase,
            addFixedCostItem = addFixedCostItem,
            updateProductionPerMonth = updateProductionPerMonth,
        )
    }

    val pricingPresenter = remember {
        PricingPresenter(
            getAllRecipes = getAllRecipesUseCase,
            getPricingConfigurationUseCase = getPricingConfigurationUseCase,
            calculatePricingSummaryUseCase = calculatePricingSummaryUseCase,
            savePricingConfiguration = savePricingConfiguration,
        )
    }

    val priceListPresenter = remember {
        PriceListPresenter(
            getPriceListProductsUseCase = getPriceListProductsUseCase,
            getPriceListCostBasisUseCase = getPriceListCostBasisUseCase,
            setPriceListCostBasisUseCase = setPriceListCostBasisUseCase,
            buildPriceListRowsUseCase = buildPriceListRowsUseCase,
            addPriceListProduct = addPriceListProduct,
            calculatePricingSummaryUseCase = calculatePricingSummaryUseCase,
            getAllRecipes = getAllRecipesUseCase,
        )
    }

    val dashboardPresenter = remember {
        DashboardPresenter(
            getAllRecipes = getAllRecipesUseCase,
            calculateRecipeCost = calculateRecipeCost,
            calculateFixedCostSummaryUseCase = calculateFixedCostSummaryUseCase,
            getPricingConfigurationUseCase = getPricingConfigurationUseCase,
            calculatePricingSummaryUseCase = calculatePricingSummaryUseCase,
        )
    }

    AppContent(
        dashboardPresenter = dashboardPresenter,
        ingredientPresenter = ingredientPresenter,
        recipePresenter = recipePresenter,
        fixedCostPresenter = fixedCostPresenter,
        pricingPresenter = pricingPresenter,
        priceListPresenter = priceListPresenter,
    )
}

@Composable
private fun AppContent(
    dashboardPresenter: DashboardPresenter,
    ingredientPresenter: IngredientPresenter,
    recipePresenter: RecipePresenter,
    fixedCostPresenter: FixedCostPresenter,
    pricingPresenter: PricingPresenter,
    priceListPresenter: PriceListPresenter,
) {
    var selectedScreen by remember { mutableStateOf(AppScreen.DASHBOARD) }

    Column(
        modifier = Modifier
            .fillMaxSize()
            .padding(16.dp)
            .verticalScroll(rememberScrollState()),
        verticalArrangement = Arrangement.spacedBy(12.dp),
    ) {
        NavigationBar(
            selectedScreen = selectedScreen,
            onSelectScreen = { selectedScreen = it },
        )

        when (selectedScreen) {
            AppScreen.DASHBOARD -> DashboardScreen(
                presenter = dashboardPresenter,
                onNavigate = { selectedScreen = it },
            )

            AppScreen.COSTOS_POR_PIZZA -> PricingScreen(
                presenter = pricingPresenter,
            )

            AppScreen.NUEVA_RECETA -> RecipeScreen(
                presenter = recipePresenter,
                title = "Nueva receta",
                onlyCreateRecipe = false,
            )

            AppScreen.INGREDIENTES -> IngredientScreen(
                presenter = ingredientPresenter,
            )

            AppScreen.GASTOS_FIJOS -> FixedCostScreen(
                presenter = fixedCostPresenter,
            )

            AppScreen.LISTA_PRECIOS -> PriceListScreen(
                presenter = priceListPresenter,
            )

        }
    }
}

@Composable
private fun NavigationBar(
    selectedScreen: AppScreen,
    onSelectScreen: (AppScreen) -> Unit,
) {
    val scrollState = rememberScrollState()
    Row(
        modifier = Modifier
            .fillMaxWidth()
            .horizontalScroll(scrollState),
        horizontalArrangement = Arrangement.spacedBy(8.dp),
    ) {
        val navigationScreens = listOf(
            AppScreen.DASHBOARD,
            AppScreen.COSTOS_POR_PIZZA,
            AppScreen.NUEVA_RECETA,
            AppScreen.INGREDIENTS,
            AppScreen.GASTOS_FIJOS,
            AppScreen.LISTA_PRECIOS,
        )

        navigationScreens.forEach { screen ->
            val label = when (screen) {
                AppScreen.DASHBOARD -> "Dashboard"
                AppScreen.COSTOS_POR_PIZZA -> "Costos por pizza"
                AppScreen.NUEVA_RECETA -> "Nueva receta"
                AppScreen.INGREDIENTS -> "Ingredientes"
                AppScreen.RECIPES -> "Recetas"
                AppScreen.COSTS -> "Costos"
                AppScreen.GASTOS_FIJOS -> "Gastos fijos"
                AppScreen.LISTA_PRECIOS -> "Lista de precios"
            }
            Button(onClick = { onSelectScreen(screen) }) {
                Text(if (screen == selectedScreen) "[$label]" else label)
            }
        }
    }
}
