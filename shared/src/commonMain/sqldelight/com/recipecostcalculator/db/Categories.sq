CREATE TABLE categories (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    unit_label TEXT NOT NULL,
    sort_order INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

selectAll:
SELECT * FROM categories ORDER BY sort_order ASC, name ASC;

selectById:
SELECT * FROM categories WHERE id = :id;

selectAllWithCount:
SELECT c.id, c.name, c.unit_label, c.sort_order, c.created_at, c.updated_at,
       COUNT(r.id) AS recipe_count
FROM categories c
LEFT JOIN recipes r ON r.category_id = c.id
GROUP BY c.id
ORDER BY c.sort_order ASC, c.name ASC;

insert:
INSERT INTO categories(name, unit_label, sort_order, created_at, updated_at)
VALUES (:name, :unitLabel, :sortOrder, :createdAt, :updatedAt);

update:
UPDATE categories SET name = :name, unit_label = :unitLabel, sort_order = :sortOrder, updated_at = :updatedAt
WHERE id = :id;

delete:
DELETE FROM categories WHERE id = :id;

countRecipes:
SELECT COUNT(*) FROM recipes WHERE category_id = :categoryId;

lastInsertId:
SELECT last_insert_rowid();
