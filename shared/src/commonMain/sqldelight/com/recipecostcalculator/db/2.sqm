CREATE TABLE categories (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    unit_label TEXT NOT NULL,
    sort_order INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

INSERT INTO categories(name, unit_label, sort_order, created_at, updated_at)
VALUES ('Pizzas', 'pizzas', 0, strftime('%s','now') * 1000, strftime('%s','now') * 1000);

ALTER TABLE recipes ADD COLUMN category_id INTEGER REFERENCES categories(id);

UPDATE recipes SET category_id = (SELECT id FROM categories WHERE name = 'Pizzas');
